# Copier vers .env et renseigner. Ne jamais committer .env.
# Aucune de ces variables n'est exposée au navigateur (pas de préfixe NEXT_PUBLIC_).

NODE_ENV=development

# Dev/test : SQLite. Production : PostgreSQL (voir README « Base de données »).
DATABASE_URL="file:./dev.db"

# Secret de signature des sessions et jetons. 32 caractères minimum.
# Générer : openssl rand -base64 48
APP_SECRET="remplacer-par-un-secret-aleatoire-de-48-octets-minimum"

# Racine de stockage privée des documents, hors racine web.
STORAGE_ROOT="./var/storage"
MAX_UPLOAD_MB=25

APP_URL="http://localhost:3000"

# console = les e-mails sont écrits dans les logs (développement uniquement)
EMAIL_PROVIDER=console
EMAIL_FROM="Direct Conseil <no-reply@directconseil.ma>"
# SMTP_URL="smtps://user:pass@smtp.exemple.ma:465"

# --- Démonstration hébergée (voir DEPLOIEMENT.md) ---
# Sur un hébergeur avec disque persistant monté sur /data :
# DATABASE_URL="file:/data/prod.db"
# STORAGE_ROOT="/data/storage"
# APP_URL="https://votre-app.up.railway.app"
# Le démarrage `npm run start:hosted` crée le schéma et charge les règles
# d'échéances au premier lancement, puis à chaque redémarrage sans rien écraser.
