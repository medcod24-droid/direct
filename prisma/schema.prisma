// Direct Conseil — schéma de données
//
// Provider: sqlite en dev/test, postgresql en production (voir README « Base de données »).
// Aucun enum Prisma n'est utilisé : SQLite ne les supporte pas. Les valeurs sont des String
// contraintes côté application par des unions TypeScript + Zod (src/lib/domain/enums.ts).
//
// Règle d'or de multi-tenancy : tout modèle appartenant à un cabinet porte `cabinetId`
// et est indexé dessus. L'accès passe obligatoirement par le client Prisma étendu
// (src/lib/db/tenant.ts) qui injecte le filtre. Voir SECURITY.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Plateforme (non multi-tenant) : plans, cabinets, utilisateurs, sessions
// ---------------------------------------------------------------------------

model Plan {
  id        String  @id @default(cuid())
  code      String  @unique // starter | professional | business | enterprise
  name      String
  priceMad  Int // prix mensuel HT en centimes de dirham
  interval  String  @default("month") // month | year
  isPublic  Boolean @default(true)
  sortOrder Int     @default(0)

  // Entitlements (null = illimité). Jamais lus depuis le client : voir lib/billing.
  maxClients        Int?
  maxUsers          Int?
  maxStorageMb      Int?
  maxMonthlyUploads Int?
  features          String @default("[]") // JSON: string[] de codes de fonctionnalités

  subscriptions Subscription[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Cabinet {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  // Identité légale du cabinet lui-même
  ice      String?
  if       String?
  rc       String?
  // Numéro d'inscription à l'ordre (OPCA / OEC) — exigé à l'onboarding, cf. loi 127-12
  ordre    String? // OPCA | OEC
  ordreNum String?
  city     String?
  phone    String?
  email    String?
  locale   String  @default("fr") // fr | ar | en
  timezone String  @default("Africa/Casablanca")

  // Mode de conformité CNDP : "declaration" (sans n° CIN) ou "authorization" (n° CIN autorisé)
  cndpMode    String  @default("declaration")
  cndpRef     String?
  storageUsed Int     @default(0) // octets

  subscription Subscription?
  memberships  Membership[]
  clients      Client[]
  contacts     Contact[]
  documents    Document[]
  requests     DocumentRequest[]
  tasks        Task[]
  deadlines    Deadline[]
  rules        DeadlineRule[]
  invoices     ClientInvoice[]
  messages     Message[]
  notifications Notification[]
  auditLogs    AuditLog[]
  activities   Activity[]
  interventions Intervention[]
  appointments Appointment[]
  todos        Todo[]
  results      MonthlyResult[]
  categories   DocumentCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id        String @id @default(cuid())
  cabinetId String @unique
  planId    String

  status           String    @default("trialing") // trialing | active | past_due | canceled
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  canceledAt       DateTime?
  externalRef      String? // référence chez le prestataire de paiement (Stripe, CMI…)

  cabinet   Cabinet  @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  plan      Plan     @relation(fields: [planId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId])
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String
  phone        String?
  locale       String  @default("fr")
  isActive     Boolean @default(true)

  // 2FA : architecture posée, activation dans une version ultérieure
  twoFactorSecret     String?
  twoFactorEnabled    Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  memberships   Membership[]
  sessions      Session[]
  assignments   ClientAssignment[]
  uploads       Document[]         @relation("DocumentUploader")
  reviewed      DocumentRequest[]  @relation("RequestReviewer")
  requested     DocumentRequest[]  @relation("RequestCreator")
  tasksAssigned Task[]             @relation("TaskAssignee")
  tasksCreated  Task[]             @relation("TaskCreator")
  deadlines     Deadline[]         @relation("DeadlineAssignee")
  notifications Notification[]
  messages      Message[]
  comments      TaskComment[]
  interventions Intervention[]  @relation("InterventionAuthor")
  appointments  Appointment[]   @relation("AppointmentOwner")
  todos         Todo[]          @relation("TodoAssignee")
  todosReviewed Todo[]          @relation("TodoReviewer")
  auditLogs     AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Lien utilisateur <-> cabinet. Porte le rôle et la portée d'accès.
model Membership {
  id        String @id @default(cuid())
  userId    String
  cabinetId String

  role   String  @default("accountant") // owner | admin | accountant | assistant | client
  status String  @default("active") // active | suspended
  /// true = l'utilisateur ne voit que les clients qui lui sont assignés
  restrictedToAssigned Boolean @default(false)
  /// Pour le rôle « client » : le dossier client auquel ce compte est rattaché
  clientId String?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  cabinet Cabinet @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  client  Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, cabinetId])
  @@index([cabinetId, role])
  @@index([clientId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique // SHA-256 du jeton ; le jeton en clair n'est jamais stocké
  userId    String
  cabinetId String? // cabinet actif de la session
  expiresAt DateTime
  ip        String?
  userAgent String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// CRM : clients, contacts, assignations
// ---------------------------------------------------------------------------

model Client {
  id        String @id @default(cuid())
  cabinetId String

  /// company | individual
  kind    String @default("company")
  /// sarl | sarl_au | sa | sas | snc | succursale | gie | association | cooperative |
  /// syndic | auto_entrepreneur | cpu | rnr | rns | particulier | autre
  subtype String
  /// Nom de la forme quand `subtype = "autre"` : la liste fermée ne couvre pas tout.
  subtypeOther String?

  legalName String
  tradeName String?
  ice       String?
  if        String?
  rc        String?
  rcCourt   String?
  taxProfNo String?
  cnssNo    String?
  /// Stocké uniquement si cabinet.cndpMode = "authorization" (loi 09-08, art. 12-1-e)
  managerCin      String?
  managerCinValid DateTime?
  managerName     String?

  address  String?
  city     String?
  phone    String?
  email    String?
  website  String?
  activity String?

  /// Numéro d'autorisation d'exercer, quand l'activité est réglementée.
  authorizationNo String?
  /// Nombre de salariés déclarés (le détail nominatif reste hors de la plateforme).
  employeeCount   Int?

  /// --- Personne physique -----------------------------------------------------
  /// Délégation (subdivision fiscale de rattachement).
  taxDistrict String?
  /// Enseigne commerciale (الاسم التجاري) : le nom est dans `tradeName`.
  signNo         String?
  signRefDate    DateTime?
  signExpiresAt  DateTime?
  /// Domicile du contribuable, distinct de `address` qui est le lieu d'exercice.
  personalAddress String?
  /// Immatriculation CNSS de la personne (9 chiffres) ; `cnssNo` est l'affiliation employeur.
  cnssRegNo        String?
  cnssAffiliatedAt DateTime?

  /// --- Personne morale -------------------------------------------------------
  /// Certificat négatif : réservation de la dénomination avant immatriculation.
  negCertNo        String?
  negCertDate      DateTime?
  negCertExpiresAt DateTime?
  /// Siège chez un domiciliataire plutôt qu'en local propre.
  isDomiciled Boolean @default(false)

  /// --- Listes -----------------------------------------------------------------
  /// Le schéma reste compatible SQLite : ces listes sont du JSON, comme `tags`.
  /// `activities` est déjà la relation vers le journal : le nom est donc explicite.
  declaredActivities String @default("[]") // JSON: string[]

  /// Immatriculations au registre de commerce, arborescentes.
  /// JSON: { number, court, taxProfNos: string[], branches: { number, court, taxProfNos: string[] }[] }[]
  ///
  /// Un commerçant n'a qu'une immatriculation **principale** (art. 39 du code de
  /// commerce), mais autant d'immatriculations **secondaires** que de tribunaux
  /// où il exploite (art. 38 et 41) ; un établissement ouvert dans le ressort du
  /// même tribunal reste rattaché à l'immatriculation existante — d'où
  /// l'imbrication. La taxe professionnelle, elle, est établie au lieu de chaque
  /// établissement (art. 8 de la loi 47-06) et son numéro d'identification doit
  /// être affiché dans chacun d'eux (art. 14) : elle se rattache donc à
  /// l'établissement, principal comme secondaire.
  registrations String @default("[]")

  /// Projections plates de `registrations`, reconstruites à chaque écriture :
  /// la recherche et les listes n'ont pas à parcourir l'arbre. `rc`, `rcCourt` et
  /// `taxProfNo` gardent de même la première immatriculation.
  taxProfNos  String @default("[]") // JSON: string[]
  branches    String @default("[]") // JSON: { number, court }[]

  /// JSON: { role, name, cin, address, phone }[] — `cin` obéit au mode CNDP.
  partners    String @default("[]")
  /// JSON: { name, cin, cnssNo }[] — données de tiers : `cin` obéit au mode CNDP.
  employees   String @default("[]")

  /// Articles d'imposition d'un particulier : un par bien imposé.
  /// JSON: { id, number, designation, address, usage }[]
  ///
  /// L'usage commande le traitement : la taxe d'habitation n'abat la valeur
  /// locative que pour l'habitation principale (loi 47-06, art. 20), un bien loué
  /// n'y est pas soumis mais produit des revenus fonciers imposables à l'IR.
  articles String @default("[]")

  /// Régime et attributs qui pilotent le moteur d'échéances
  fiscalYearEndMonth Int     @default(12)
  fiscalYearEndDay   Int     @default(31)
  vatRegime          String  @default("quarterly") // monthly | quarterly | exempt
  taxRegime          String  @default("is") // is | rnr | rns | cpu | auto_entrepreneur | none
  isEmployer         Boolean @default(false)
  referenceRevenue   Int? // CA N-1 en centimes de dirham
  referenceRevenueSource String? // import_balance | manual | declaration

  /// Aucune obligation n'est générée avant cette date (évite un historique rouge au jour 1)
  takeoverDate DateTime
  startedAt    DateTime?

  /// Dossier apporté par un autre client du cabinet, s'il y a lieu.
  /// La relation reste dans le cabinet : c'est le client Prisma étendu qui le garantit.
  referredById String?

  /// Texte normalisé des champs cherchables : voir lib/search.ts.
  searchKey String @default("")

  status       String  @default("active") // prospect | onboarding | active | suspended | terminated | archived
  activityState String @default("running") // running | dormant | liquidation | struck_off
  priority     String  @default("normal") // low | normal | high
  tags         String  @default("[]") // JSON: string[]
  notes        String?
  acquisition  String?

  /// Honoraires récurrents (suivi de facturation du cabinet, pas la compta du client)
  feeAmount    Int? // centimes de dirham HT
  feeFrequency String? // monthly | quarterly | yearly | none

  cabinet     Cabinet            @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  referredBy  Client?            @relation("ClientReferral", fields: [referredById], references: [id], onDelete: SetNull)
  referrals   Client[]           @relation("ClientReferral")
  contacts    Contact[]
  assignments ClientAssignment[]
  documents   Document[]
  requests    DocumentRequest[]
  tasks       Task[]
  deadlines   Deadline[]
  invoices    ClientInvoice[]
  messages    Message[]
  activities  Activity[]
  interventions Intervention[]
  appointments Appointment[]
  todos       Todo[]
  portalUsers Membership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cabinetId, status])
  @@index([cabinetId, searchKey])
  @@index([cabinetId, referredById])
  @@index([cabinetId, legalName])
  @@index([cabinetId, ice])
  @@index([cabinetId, if])
}

/// Registre des services rendus au client par le cabinet.
///
/// À ne pas confondre avec `Activity`, qui est la trace **automatique** de ce que
/// la plateforme enregistre. Ici, c'est le comptable qui écrit : quel service, à
/// quelle date, pourquoi, et ce qu'il en est résulté. C'est ce registre que l'on
/// relit pour savoir ce que le cabinet a fait pour un dossier, et qui s'imprime
/// avec la fiche.
model Intervention {
  id        String @id @default(cuid())
  cabinetId String
  clientId  String

  /// Nom du service rendu
  service     String
  performedAt DateTime
  /// Pourquoi il a été rendu
  reason String?
  /// Ce qui a été fait, et ce qu'il en est résulté
  report String?

  createdById String?

  cabinet   Cabinet @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("InterventionAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cabinetId, clientId, performedAt])
}

/// Rendez-vous du cabinet avec un client.
///
/// **Les heures sont des heures murales.** `startsAt` est construit et relu en
/// UTC, sans conversion : un rendez-vous saisi à 9 h s'affiche à 9 h, que le
/// serveur tourne à Casablanca ou sur un hébergeur en UTC. Convertir aurait
/// décalé tous les horaires d'une heure en production, sans erreur visible —
/// et un cabinet n'a de toute façon qu'un seul fuseau.
model Appointment {
  id        String @id @default(cuid())
  cabinetId String
  clientId  String

  /// Objet du rendez-vous, tel qu'il s'affiche dans le calendrier
  title           String
  startsAt        DateTime
  durationMinutes Int      @default(30)

  /// office | client_site | phone | video
  mode     String  @default("office")
  /// Adresse ou lien, quand le mode ne suffit pas
  location String?
  /// Ce qu'il faut préparer avant le rendez-vous
  preparation String?

  /// scheduled | done | cancelled | no_show
  status String @default("scheduled")
  /// Compte rendu saisi à la validation ; recopié dans la liste d'activité
  outcome String?

  /// Collaborateur qui reçoit
  assignedToId String?
  /// Ligne créée dans la liste d'activité à la validation
  interventionId String?
  createdById    String?

  cabinet    Cabinet @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  client     Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignedTo User?   @relation("AppointmentOwner", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cabinetId, startsAt])
  @@index([cabinetId, clientId, startsAt])
  @@index([cabinetId, status, startsAt])
}

/// Tâche confiée par l'administrateur à un collaborateur de l'équipe.
///
/// Distincte de `Task`, qui porte le travail d'un dossier et que tout
/// collaborateur peut créer. Ici, l'administrateur distribue le travail du jour
/// et la tâche revient vers lui : le collaborateur la rend avec une note, elle
/// passe en attente de confirmation, et c'est l'administrateur qui la clôt.
/// Trois états visibles, trois couleurs : confiée, rendue (orange), confirmée
/// (vert).
model Todo {
  id        String @id @default(cuid())
  cabinetId String
  /// Collaborateur à qui la tâche est confiée
  assigneeId String
  /// Dossier concerné, quand la tâche en vise un
  clientId String?

  title    String
  details  String?
  dueDate  DateTime?
  priority String    @default("normal") // low | normal | high | urgent

  /// assigned | submitted | approved | returned
  status String @default("assigned")

  /// Ce que le collaborateur écrit en rendant la tâche : fait, ou ce qui manque
  submittedNote String?
  submittedAt   DateTime?
  /// Ce que l'administrateur écrit s'il la renvoie
  reviewNote   String?
  approvedAt   DateTime?
  approvedById String?

  createdById String?

  cabinet    Cabinet @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  client     Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assignee   User    @relation("TodoAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  approvedBy User?   @relation("TodoReviewer", fields: [approvedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cabinetId, assigneeId, status])
  @@index([cabinetId, status, dueDate])
}

/// Résultat mensuel du cabinet, saisi à la main.
///
/// Ce n'est pas la comptabilité des clients : c'est celle du cabinet lui-même.
/// Elle reste manuelle par choix — les honoraires facturés ne disent ni ce qui a
/// été encaissé ni ce qui a été dépensé, et un chiffre déduit à moitié serait
/// pire qu'un chiffre assumé.
///
/// Montants en **centimes de dirham**, comme partout ailleurs.
model MonthlyResult {
  id        String @id @default(cuid())
  cabinetId String

  /// Premier jour du mois, à minuit UTC : la clé du mois, pas une date de saisie.
  month    DateTime
  revenue  Int      @default(0)
  expenses Int      @default(0)
  notes    String?

  recordedById String?

  cabinet Cabinet @relation(fields: [cabinetId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cabinetId, month])
  @@index([cabinetId, month])
}

model Contact {
  id        String  @id @default(cuid())
  cabinetId String
  clientId  String
  name      String
  position  String?
  phone     String?
  email     String?
  isPrimary Boolean @default(false)
  notes     String?

  cabinet Cabinet @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cabinetId, clientId])
}

/// Assignation d'un collaborateur à un dossier (portée d'accès au niveau ressource)
model ClientAssignment {
  id        String @id @default(cuid())
  cabinetId String
  clientId  String
  userId    String
  role      String @default("responsible") // responsible | reviewer | contributor

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([clientId, userId])
  @@index([cabinetId, userId])
}

// ---------------------------------------------------------------------------
// Documents
// ---------------------------------------------------------------------------

model DocumentCategory {
  id        String  @id @default(cuid())
  /// null = catégorie système, visible par tous les cabinets
  cabinetId String?
  code      String
  name      String
  kind      String  @default("recurring") // permanent | recurring | fiscal | social | legal | fees
  sortOrder Int     @default(0)

  cabinet   Cabinet?   @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  documents Document[]

  @@unique([cabinetId, code])
}

model Document {
  id         String  @id @default(cuid())
  cabinetId  String
  clientId   String?
  categoryId String?

  /// Nom d'origine, affiché ; jamais utilisé pour écrire sur le disque
  filename   String
  /// Clé de stockage opaque (uuid), relative à la racine de stockage privée
  storageKey String  @unique
  mimeType   String
  size       Int
  /// SHA-256 du contenu : intégrité (loi 53-05) et détection de doublons
  checksum   String
  version    Int     @default(1)
  replacesId String?

  /// Texte normalisé pour la recherche : nom du fichier et notes.
  searchKey String @default("")

  /// Champ de la fiche que ce document justifie : « cin », « ice », « rc:<id> »…
  /// Null pour une pièce ordinaire du dossier permanent. Un seul document actif
  /// par champ : le dépôt suivant remplace le précédent.
  fieldKey String?

  documentDate DateTime?
  expiresAt    DateTime?
  status       String    @default("received") // received | approved | rejected | archived
  tags         String    @default("[]")
  notes        String?

  uploadedById String?
  uploadedVia  String @default("cabinet") // cabinet | portal | import

  cabinet    Cabinet           @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  client     Client?           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  category   DocumentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  uploadedBy User?             @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  request    DocumentRequest?  @relation("RequestFulfillment")
  proofFor   Deadline[]        @relation("DeadlineProof")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cabinetId, clientId])
  @@index([cabinetId, clientId, fieldKey])
  @@index([cabinetId, status])
  @@index([cabinetId, expiresAt])
}

model DocumentRequest {
  id          String    @id @default(cuid())
  cabinetId   String
  clientId    String
  title       String
  description String?
  periodLabel String? // ex. « janvier 2027 »
  dueDate     DateTime?

  status String @default("pending") // pending | submitted | approved | rejected | cancelled

  requestedById   String?
  documentId      String?   @unique
  submittedAt     DateTime?
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?

  cabinet     Cabinet   @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  requestedBy User?     @relation("RequestCreator", fields: [requestedById], references: [id], onDelete: SetNull)
  reviewedBy  User?     @relation("RequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  document    Document? @relation("RequestFulfillment", fields: [documentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cabinetId, status])
  @@index([cabinetId, clientId])
}

// ---------------------------------------------------------------------------
// Travail : tâches, échéances
// ---------------------------------------------------------------------------

model Task {
  id          String    @id @default(cuid())
  cabinetId   String
  clientId    String?
  title       String
  description String?
  priority    String    @default("normal") // low | normal | high | urgent
  status      String    @default("todo") // todo | in_progress | waiting_client | done | cancelled
  dueDate     DateTime?
  completedAt DateTime?

  assigneeId  String?
  createdById String?

  cabinet   Cabinet       @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  client    Client?       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignee  User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User?         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  comments  TaskComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cabinetId, status, dueDate])
  @@index([cabinetId, assigneeId])
  @@index([cabinetId, clientId])
}

model TaskComment {
  id        String @id @default(cuid())
  cabinetId String
  taskId    String
  authorId  String?
  body      String

  task   Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([cabinetId, taskId])
}

/// Règle d'échéance paramétrable. Aucune date légale n'est codée en dur ailleurs.
/// cabinetId null = règle système fournie par la plateforme ; un cabinet peut la surcharger.
model DeadlineRule {
  id        String  @id @default(cuid())
  cabinetId String?
  code      String
  label     String
  labelAr   String?

  /// Conditions d'application (JSON) évaluées par lib/deadlines/engine.ts
  /// ex. {"taxRegime":["is"],"isEmployer":true,"vatRegime":["monthly"]}
  appliesTo String @default("{}")

  frequency String // monthly | quarterly | yearly | event
  /// Formule de date (JSON) : {"type":"day_of_month","month":3,"day":31,"beforeDay":true}
  /// {"type":"months_after_fy_end","months":3} | {"type":"end_of_next_month"} …
  dateFormula String
  portal      String? // simpl | damancom | greffe | rn_ae | commune
  proofLabel  String?
  /// Formule de pénalité (JSON), sert à estimer le coût du retard
  penaltyFormula String?
  legalRef       String? // ex. « CGI art. 110 »
  lawVersion     String  @default("2026")
  /// verified = confronté au texte ; to_confirm = source secondaire (affiché à l'admin)
  verificationStatus String @default("to_confirm")
  isActive           Boolean @default(true)

  cabinet   Cabinet?   @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  deadlines Deadline[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cabinetId, code, lawVersion])
}

model Deadline {
  id        String  @id @default(cuid())
  cabinetId String
  clientId  String
  ruleId    String?

  label       String
  periodLabel String // ex. « TVA 03/2027 » — sert à l'unicité
  dueDate     DateTime
  status      String @default("upcoming") // upcoming | in_progress | declared | paid | overdue | not_applicable
  /// cabinet | client | third_party — ce qui n'est pas géré par le cabinet ne compte pas en rouge
  managedBy   String @default("cabinet")
  priority    String @default("normal")

  declaredAt      DateTime?
  paidAt          DateTime?
  proofDocumentId String?
  assigneeId      String?
  notes           String?
  /// Journal du « mode panne » (JSON) : tentatives horodatées, messages d'erreur
  outageLog       String?
  /// Texte normalisé pour la recherche : libellé et période.
  searchKey       String @default("")
  penaltyEstimate Int? // centimes de dirham

  cabinet Cabinet       @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  client  Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  rule    DeadlineRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  proof   Document?     @relation("DeadlineProof", fields: [proofDocumentId], references: [id], onDelete: SetNull)
  assignee User?        @relation("DeadlineAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, periodLabel])
  @@index([cabinetId, status, dueDate])
  @@index([cabinetId, clientId])
  @@index([cabinetId, dueDate])
}

// ---------------------------------------------------------------------------
// Communication, notifications, facturation client, journal
// ---------------------------------------------------------------------------

model Message {
  id        String  @id @default(cuid())
  cabinetId String
  clientId  String
  authorId  String?
  body      String
  /// true = note interne, jamais visible du client
  isInternal Boolean @default(false)
  readAt     DateTime?

  cabinet Cabinet @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  author  User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([cabinetId, clientId, createdAt])
}

model Notification {
  id        String  @id @default(cuid())
  cabinetId String
  userId    String
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?

  cabinet Cabinet @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([cabinetId, createdAt])
}

/// Facturation des honoraires du cabinet à ses clients (pas la comptabilité du client)
model ClientInvoice {
  id        String @id @default(cuid())
  cabinetId String
  clientId  String

  reference   String
  label       String?
  amount      Int // centimes de dirham HT
  vatRate     Int     @default(20) // pourcentage
  paidAmount  Int     @default(0)
  currency    String  @default("MAD")
  issuedAt    DateTime
  dueDate     DateTime
  paidAt      DateTime?
  status      String  @default("pending") // pending | partial | paid | overdue | cancelled
  paymentMode String? // cash | cheque | transfer | card
  notes       String?

  cabinet Cabinet @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cabinetId, reference])
  @@index([cabinetId, status, dueDate])
  @@index([cabinetId, clientId])
}

/// Journal d'audit — append-only. Aucune mutation exposée dans l'application.
model AuditLog {
  id           String  @id @default(cuid())
  cabinetId    String?
  userId       String?
  action       String // ex. document.download
  resourceType String?
  resourceId   String?
  /// JSON, jamais de contenu de document ni de secret
  metadata     String?
  ip           String?
  userAgent    String?
  outcome      String  @default("success") // success | denied | error

  cabinet Cabinet? @relation(fields: [cabinetId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([cabinetId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}

/// Timeline visible dans la fiche client (sous-ensemble lisible du journal)
model Activity {
  id        String  @id @default(cuid())
  cabinetId String
  clientId  String?
  actorId   String?
  type      String // document.uploaded | request.created | task.created | deadline.declared …
  summary   String
  metadata  String?
  /// true = visible dans le portail client
  visibleToClient Boolean @default(false)

  cabinet Cabinet @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  client  Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([cabinetId, clientId, createdAt])
}
